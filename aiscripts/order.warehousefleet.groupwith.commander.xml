<?xml version="1.0" encoding="utf-8"?>
<aiscript name="order.warehousefleet.groupwith.commander" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd" version="1">
  <!--
    Assign a WarehouseFleet ship under a commander station for map/property-menu grouping only.

    This intentionally copies the commander/group mutation core from vanilla AssignCommander, but
    does not call lib.request.orders and does not cancel existing orders. The ship keeps its
    WarehouseFleet default behaviour; the commander is only a hierarchy/grouping anchor.
  -->
  <order id="WarehouseFleetGroupWithCommander" name="WarehouseFleet Group With Commander" description="Assign this ship under a commander for grouping while preserving WarehouseFleet behaviour." category="internal" allowinloop="false">
    <params>
      <param name="commander" required="true" type="object" text="Commander" comment="Station to group this ship under. Usually the same station as the WarehouseFleet home warehouse.">
        <input_param name="class" value="[class.station]"/>
        <input_param name="owner" value="this.ship.trueowner"/>
      </param>
      <param name="assignment" default="assignment.warehousefleet" type="internal" text="Assignment" comment="Grouping assignment. Defaults to the custom WarehouseFleet assignment."/>
      <param name="subordinategroup" default="0" type="number" text="Subordinate group" comment="0 lets the engine pick or create a group for the assignment. A positive value targets Alpha/Beta/Gamma/etc.">
        <input_param name="min" value="0"/>
        <input_param name="max" value="10"/>
        <input_param name="step" value="1"/>
      </param>
      <param name="setgroupassignment" default="false" type="bool" text="Set group assignment" comment="If true and subordinategroup is positive, force that group to use the given assignment."/>
      <param name="usecommanderassource" default="true" type="bool" text="Commander is home warehouse" comment="If true, also set the WarehouseFleet Home Warehouse parameter to this commander."/>
      <param name="informfleetmanager" default="true" type="internal" comment="Passed to set_object_commander."/>
      <param name="debugchance" type="bool" default="0" advanced="true" text="Debug">
        <input_param name="truevalue" value="100"/>
      </param>
    </params>
    <requires>
      <match shiptype="shiptype.lasertower" negate="true"/>
      <match class="class.spacesuit" negate="true"/>
    </requires>
    <location object="$commander" condition="@$commander.isoperational"/>
  </order>

  <attention min="unknown">
    <actions>
      <debug_text text="'WarehouseFleetGroupWithCommander called. commander: %s, assignment: %s, group %s, setgroupassignment: %s, usecommanderassource: %s'.[$commander, $assignment, $subordinategroup, $setgroupassignment, $usecommanderassource]" chance="$debugchance"/>

      <do_if value="not @$commander.isoperational">
        <debug_text text="'WarehouseFleetGroupWithCommander: commander is not operational.'"  chance="$debugchance"/>
        <return value="false"/>
      </do_if>

      <do_if value="$commander.trueowner != this.trueowner">
        <debug_text text="'%s (%s) tried to be grouped under %s (%s), which belongs to a different faction. denied.'.[this.object.knownname, this.object, @$commander.knownname, $commander]"  chance="$debugchance"/>
        <return value="false"/>
      </do_if>

      <do_if value="this.assignedcontrolled.gatedistance.{$commander} lt 0">
        <debug_text text="'WarehouseFleetGroupWithCommander: commander is unreachable.'"  chance="$debugchance"/>
        <return value="false"/>
      </do_if>

      <set_value name="$warehousefleetorder" exact="if @this.assignedcontrolled.defaultorder.id == 'Assist' then this.assignedcontrolled.defaultorder.$baseorder else this.assignedcontrolled.defaultorder"/>
      <do_if value="not @$warehousefleetorder.exists or $warehousefleetorder.id != 'WarehouseFleet'">
        <debug_text text="'WarehouseFleetGroupWithCommander: default order is not WarehouseFleet, refusing to mutate commander. defaultorder=%s'.[@this.assignedcontrolled.defaultorder.id]"  chance="$debugchance"/>
        <return value="false"/>
      </do_if>

      <do_if value="$assignment">
        <!-- Needed for assignments passed in from Lua/MD as strings. -->
        <do_if value="typeof $assignment != datatype.assignment">
          <set_value name="$assignment" exact="assignment.{$assignment}"/>
        </do_if>
        <do_if value="this.assignedcontrolled.canuseassignment.{$assignment}.{$commander}">
          <do_if value="$subordinategroup and not $setgroupassignment">
            <do_if value="$commander.activesubordinategroupids.indexof.{$subordinategroup}">
              <do_if value="$commander.subordinategroupassignment.{$subordinategroup} != $assignment">
                <!-- Engine will find an existing subordinategroup with the specified assignment. -->
                <set_value name="$subordinategroup" exact="0"/>
              </do_if>
            </do_if>
            <do_else>
              <set_value name="$setgroupassignment"/>
            </do_else>
          </do_if>
        </do_if>
        <do_else>
          <debug_text text="'%s %s %s cannot use specified assignment: %s'.[@this.object.idcode, @this.object.knownname, this.object, $assignment]"  chance="$debugchance"/>
          <return value="false"/>
        </do_else>
      </do_if>

      <do_if value="$setgroupassignment and $assignment and ($subordinategroup gt 0)">
        <debug_text text="'WarehouseFleetGroupWithCommander: setting group %s assignment to %s'.[$subordinategroup, $assignment]" chance="$debugchance"/>
        <set_subordinate_group_assignment object="this.object" commander="$commander" subordinategroupid="$subordinategroup" assignment="$assignment"/>
      </do_if>

      <do_if value="this.object.commander">
        <!-- Same cleanup vanilla AssignCommander performs when moving between commanders. -->
        <remove_ware_reservation object="this.object.commander" reserver="this.object" type="sell" virtual="true"/>
        <remove_ware_reservation object="this.object.commander" reserver="this.object" type="buy" virtual="true"/>
      </do_if>

      <do_if value="$subordinategroup gt 0">
        <set_object_commander object="this.object" commander="$commander" informfleetmanager="$informfleetmanager" subordinategroupid="$subordinategroup"/>
      </do_if>
      <do_elseif value="$assignment">
        <set_object_commander object="this.object" commander="$commander" informfleetmanager="$informfleetmanager" assignment="$assignment"/>
      </do_elseif>
      <do_else>
        <set_object_commander object="this.object" commander="$commander" informfleetmanager="$informfleetmanager"/>
      </do_else>

      <do_if value="this.object.commander != $commander">
        <debug_text text="'WarehouseFleetGroupWithCommander: commander failed to change to %s (%s). Still %s (%s)'.[@$commander.knownname, $commander, @this.object.commander.knownname, this.object.commander]"  chance="$debugchance"/>
        <return value="false"/>
      </do_if>

      <do_if value="$usecommanderassource">
        <edit_order_param order="$warehousefleetorder" param="'sourceStation'" value="$commander"/>
      </do_if>

      <debug_text text="'WarehouseFleetGroupWithCommander: grouped %s (%s) under %s (%s), assignment=%s, group=%s. WarehouseFleet default order preserved.'.[this.object.knownname, this.object.idcode, $commander.knownname, $commander.idcode, this.object.assignment, this.object.subordinategroupid]" chance="$debugchance"/>
      <return value="true"/>
    </actions>
  </attention>
</aiscript>
